{
  "name": "usof-platform",
  "version": "1.0.0",
  "description": "USOF (User StackOverflow) Full Stack Platform — React Frontend & Express MySQL Backend",
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently \"npm run start:api\" \"npm run start:web\"",
    "start:api": "cd api && npm start",
    "start:web": "cd web && npm run dev",
    "build:web": "cd web && npm run build",
    "db:init": "cd api && npm run db:init",
    "db:seed": "cd api && npm run db:seed",
    "test:api": "cd api && npm test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

